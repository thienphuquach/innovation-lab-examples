# ── Agent identity ───────────────────────────────────────────────────────────
AGENT_NAME=bay-area-transit-agent
# A unique, random string. Determines the agent's permanent address.
AGENT_SEED=replace_with_a_unique_random_seed_phrase
AGENT_PORT=8090
# Wipe all session state on every "python agent.py" start (default true) - each
# fresh run behaves like a brand-new demo (pay again). Set "false" to persist.
RESET_STORAGE_ON_START=true

# ── ASI:One (model backend for Pydantic AI, OpenAI-compatible) ────────────────
# Get a key at https://asi1.ai/dashboard/api-keys
ASI_ONE_API_KEY=your_asi1_api_key_here
ASI_ONE_MODEL=asi1-mini

# ── Stripe (TEST keys only - the agent refuses to start otherwise) ────────────
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_AMOUNT_CENTS=100          # $1.00 one-time unlock fee
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=https://agentverse.ai
STRIPE_CHECKOUT_EXPIRES_SECONDS=1800
# ASI:One does not reliably send CommitPayment after its "Confirm Payment" tap,
# so the agent polls Stripe for outstanding checkouts and unlocks on its own.
STRIPE_POLL_SECONDS=3            # how often to re-read an outstanding checkout
STRIPE_POLL_GRACE_SECONDS=600    # stop polling a checkout nobody paid

# ── Transitland (two SEPARATE products on one free Interline account) ─────────
# REST API key (free tier) - stop/station geocoding fallback:
#   https://www.transit.land/documentation
Transitland_APIs=your_transitland_rest_key
# Routing API - Beta key (separate subscription, 1,000 free queries/month):
#   order the "Transitland Routing API - Beta" plan on the same account
Transitland_Routing_API=your_transitland_routing_key

# ── 511.org SF Bay Regional API (free self-serve token) ───────────────────────
# Request a token at https://511.org/open-data/token
sf_bay_511_api=your_511_api_token

# ── Agentverse External Storage (optional - confirmed-trip map image) ─────────
# Get a key at https://agentverse.ai/profile/api-keys.
# Optional: without it, the trip confirmation still sends normally, just with no
# map image attached (see map_image.py - this never blocks trip confirmation).
AGENTVERSE_API_KEY=your_agentverse_api_key
AGENTVERSE_URL=https://agentverse.ai
# Sent as the OSM tile-server User-Agent per their usage policy (self-identify,
# low-volume - one map render per *confirmed* trip, not per card view).
OSM_TILE_USER_AGENT=bay-area-transit-agent/1.0 (your-contact-or-repo-url)
