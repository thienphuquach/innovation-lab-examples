# Agent identity
AGENT_NAME=pill-price-agent
AGENT_SEED=replace_with_a_unique_random_seed_phrase
AGENT_PORT=8091
RESET_STORAGE_ON_START=true

# ASI:One (model backend for Pydantic AI, OpenAI-compatible)
# Get a key at https://asi1.ai/dashboard/api-keys
ASI_ONE_API_KEY=your_asi1_api_key_here
ASI_ONE_MODEL=asi1              # narration: the one place reasoning quality shows
ASI_ONE_FAST_MODEL=asi1-mini    # classification and extraction

# openFDA. Optional but recommended: without a key you get 1,000 requests/day
# per IP; with one, 120,000/day. Free at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# NADAC needs no key or registration. The CSV filename rotates with CMS's
# release schedule and is always resolved from the dataset metastore at refresh
# time, so there is no URL to configure here.
NADAC_DB_PATH=nadac_cache.sqlite3
NADAC_REFRESH_SECONDS=86400

# Stripe (TEST keys only) - one upfront charge unlocks the whole agent
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_AMOUNT_CENTS=200          # $2.00, charged once per chat window
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=https://agentverse.ai
STRIPE_CHECKOUT_EXPIRES_SECONDS=1800
STRIPE_POLL_INTERVAL_SECONDS=4  # how often the agent checks Stripe on its own after RequestPayment
